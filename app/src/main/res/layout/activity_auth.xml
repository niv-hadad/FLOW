<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/authActivityLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context="com.niv.flow.ui.auth.AuthActivity">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/authFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="836dp" />

    <LinearLayout
        android:id="@+id/changeAuthText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="50dp"
        android:layout_marginStart="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvToggleAuthTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_regular"
            android:foregroundGravity="bottom"
            android:text="Don't have an account?"
            android:textAlignment="center"
            android:textColor="#A6AEA9"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvToggleAuthClickable"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:fontFamily="@font/inter_medium"
            android:foregroundGravity="bottom"
            android:text="Sign Up"
            android:textAlignment="center"
            android:textColor="#748078"
            android:textSize="18.5sp" />

    </LinearLayout>
</LinearLayout>