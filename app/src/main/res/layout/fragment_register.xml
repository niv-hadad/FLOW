<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    tools:context=".RegisterFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:gravity="center"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvAuthTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="@font/inter_bold"
            android:text="Create Account"
            android:textAlignment="center"
            android:textColor="#25382D"
            android:textSize="36sp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvFirstName"
            android:layout_width="wrap_content"
            android:layout_height="57dp"
            android:layout_gravity="center"
            android:layout_marginTop="40dp"
            android:clickable="true"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeColor="#8A9A86"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="365dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingTop="2dp"
                android:paddingEnd="18dp"
                android:paddingBottom="18dp">

                <EditText
                    android:id="@+id/etFirstName"
                    android:layout_width="277dp"
                    android:layout_height="52dp"
                    android:fontFamily="@font/inter_regular"
                    android:hint="First Name"
                    android:inputType="textPersonName"
                    android:textColor="#7A817C"
                    android:textColorHint="#7A817C"
                    android:textSize="18sp">

                </EditText>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvLastName"
            android:layout_width="wrap_content"
            android:layout_height="57dp"
            android:layout_gravity="center"
            android:layout_marginTop="15dp"
            android:clickable="true"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeColor="#8A9A86"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="365dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingTop="2dp"
                android:paddingEnd="18dp"
                android:paddingBottom="18dp">

                <EditText
                    android:id="@+id/etLastName"
                    android:layout_width="277dp"
                    android:layout_height="52dp"
                    android:fontFamily="@font/inter_regular"
                    android:hint="Last Name"
                    android:inputType="textPersonName"
                    android:textColor="#7A817C"
                    android:textColorHint="#7A817C"
                    android:textSize="18sp">

                </EditText>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvEmailAddress"
            android:layout_width="wrap_content"
            android:layout_height="57dp"
            android:layout_gravity="center"
            android:clickable="true"
            android:layout_marginTop="15dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeColor="#8A9A86"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="365dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingTop="2dp"
                android:paddingEnd="18dp"
                android:paddingBottom="18dp">

                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="277dp"
                    android:layout_height="52dp"
                    android:fontFamily="@font/inter_regular"
                    android:hint="Email Address"
                    android:inputType="textEmailAddress"
                    android:textColor="#7A817C"
                    android:textColorHint="#7A817C"
                    android:textSize="18sp">

                </EditText>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvPassword"
            android:layout_width="wrap_content"
            android:layout_height="57dp"
            android:layout_gravity="center"
            android:layout_marginTop="15dp"
            android:clickable="true"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeColor="#8A9A86"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="365dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingTop="2dp"
                android:paddingEnd="18dp"
                android:paddingBottom="18dp">

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="277dp"
                    android:layout_height="52dp"
                    android:fontFamily="@font/inter_regular"
                    android:hint="Password"
                    android:inputType="textPassword"
                    android:textColor="#7A817C"
                    android:textColorHint="#7A817C"
                    android:textSize="18sp">

                </EditText>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitAuth"
            android:layout_width="367dp"
            android:layout_height="68dp"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/inter_bold"
            android:text="Sign Up"
            android:textColor="#25382D"
            android:textSize="20sp"
            app:backgroundTint="#40718D77"
            app:cornerRadius="12dp"
            app:strokeColor="#8A9A86"
            app:strokeWidth="2dp">

        </com.google.android.material.button.MaterialButton>

    </LinearLayout>
</LinearLayout>