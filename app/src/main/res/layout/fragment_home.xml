<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    tools:context=".HomeFragment">

    <TextView
        android:id="@+id/tvGreetingTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Good evening,"
        android:textSize="30sp" />

    <TextView
        android:id="@+id/tvGreetingName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Dov"
        android:textSize="30sp" />

    <TextView
        android:id="@+id/tvDailyInspiration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Small steps make a big journey."
        android:textSize="30sp" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnTakeABreath"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:clickable="true"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="150dp"
        app:cardElevation="5dp"
        app:strokeColor="#8A9A86"
        app:strokeWidth="3dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="15dp"
            android:paddingEnd="18dp"
            android:paddingBottom="18dp">

            <ImageView
                android:id="@+id/ivBreathBtnIcon"
                android:layout_width="wrap_content"
                android:layout_height="31dp">

            </ImageView>

            <TextView
                android:id="@+id/tvBreathBtnText"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:fontFamily="@font/nunito_regular"
                android:text="Take a breath"
                android:textAlignment="center"
                android:textColor="#2B2B2B"
                android:textSize="30sp"
                android:textStyle="bold">

            </TextView>


        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>