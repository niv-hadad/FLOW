<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="28dp"
    android:paddingBottom="32dp">

    <TextView
        android:id="@+id/tvInfoTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_bold"
        android:gravity="center"
        android:text="The Breathing Cycle"
        android:textColor="#F1F6F5"
        android:textSize="24sp" />

    <ImageView
        android:id="@+id/ivCycleInfographic"
        android:layout_width="match_parent"
        android:layout_height="290dp"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="24dp"
        android:src="@drawable/ill_breathing_cycle_infographic" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGotIt"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:fontFamily="@font/inter_bold"
        android:text="Got it"
        android:textColor="#F1F6F5"
        android:textSize="16sp"
        app:backgroundTint="#376775"
        app:cornerRadius="16dp"
        app:strokeColor="#7FAEB4"
        app:strokeWidth="1dp" />

</LinearLayout>
