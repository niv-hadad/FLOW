<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:paddingTop="60dp"
    android:paddingStart="25dp"
    android:paddingEnd="7dp"
    tools:context=".ProgressFragment">

    <TextView
        android:id="@+id/tvProgressHeader"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:fontFamily="@font/inter_bold"
        android:text="Your Wins"
        android:textColor="#25382D"
        android:textSize="32sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvWinsList"
        android:layout_width="match_parent"
        android:layout_height="570dp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_marginTop="7dp"
        android:id="@+id/cvAddWinBtn"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_gravity="end"
        android:clickable="true"
        app:cardBackgroundColor="#FFFFFF"
        app:cardElevation="0dp"
        app:strokeColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="23dp"
            android:paddingEnd="23dp"
            android:paddingBottom="18dp">

            <ImageView
                android:id="@+id/ivAddWinIcon"
                android:layout_width="150dp"
                android:layout_height="70dp"
                android:src="@drawable/progress_add_win_icon"
                app:tint="#718D77">

            </ImageView>


        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>



</LinearLayout>